{
  "name": "aerofocus-airlines",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "api:dev": "pnpm --filter @aerofocus/api dev",
    "db:generate": "pnpm --filter @aerofocus/api db:generate",
    "db:migrate": "pnpm --filter @aerofocus/api db:migrate",
    "web:dev": "pnpm --filter @aerofocus/web dev",
    "web:build": "pnpm --filter @aerofocus/web build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
