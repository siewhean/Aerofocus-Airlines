# PostgreSQL connection. Leave unset to use embedded PGlite (in-memory, or PGLITE_DATA_DIR).
DATABASE_URL=postgres://user:password@localhost:5432/aerofocus
# PGLITE_DATA_DIR=./.pglite

PORT=8787

# Signs Random Flight draws. Set a long random value in production so draws survive restarts.
SIGNING_SECRET=change-me

# Comma-separated allowed browser origins, or * for any.
CORS_ORIGINS=http://localhost:3000
