# PostgreSQL connection. Leave unset to use embedded PGlite (in-memory, or PGLITE_DATA_DIR).
DATABASE_URL=postgres://user:password@localhost:5432/aerofocus
# PGLITE_DATA_DIR=./.pglite

PORT=8787

# Signs Random Flight draws. Set a long random value in production so draws survive restarts.
SIGNING_SECRET=change-me

# Comma-separated allowed browser origins, or * for any.
CORS_ORIGINS=http://localhost:3000

# Set to true ONLY behind a reverse proxy that appends the real client address to X-Forwarded-For.
# Clients are then identified by the entry TRUST_PROXY_HOPS positions from the right (the address our
# own proxy appended); entries further left are client-controlled and ignored. Otherwise the socket
# address is used. Used to limit guest presence per client; IPv6 clients are limited per /64 prefix.
TRUST_PROXY=false
# Number of trusted proxies in front of the API (integer >= 1). Only used when TRUST_PROXY=true.
TRUST_PROXY_HOPS=1
